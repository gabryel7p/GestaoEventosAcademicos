<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestão de Eventos"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organize palestras, workshops e certificados"
            android:textSize="15sp"
            android:textColor="#666"/>


        <TextView
            android:id="@+id/txtUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bem-vindo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"/>


        <Button
            android:id="@+id/btnCadastrarEvento"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="➕ Criar Evento"
            android:textSize="18sp"
            android:layout_marginTop="25dp"/>


        <Button
            android:id="@+id/btnListarEventos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📅 Eventos Disponíveis"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/btnPresenca"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="✅ Confirmar Presença"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>


        <Button
            android:id="@+id/btnCertificado"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎓 Certificados"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>


        <Button
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⭐ Feedback"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>
        <Button
            android:id="@+id/btnLimparEventos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🗑 Limpar Eventos"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>

    </LinearLayout>

</ScrollView>